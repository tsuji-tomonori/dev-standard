{
  "$id": "https://github.com/tsuji-tomonori/dev-standard/benchmarks/schemas/trajectory-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "user",
        "assistant",
        "tool-call",
        "tool-result",
        "phase",
        "error"
      ]
    },
    "payload": {
      "type": "object"
    },
    "redacted": {
      "type": "boolean"
    },
    "run_id": {
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "schema_version": {
      "const": 1
    },
    "sequence": {
      "minimum": 0,
      "type": "integer"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "sequence",
    "kind",
    "timestamp",
    "payload",
    "redacted"
  ],
  "type": "object"
}
