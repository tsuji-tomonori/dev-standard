{
  "schema_version": 3,
  "policy_revision": 3,
  "selector_version": "execution-selector-v3",
  "rollout_phase": "shadow",
  "repository_blocking": false,
  "max_metadata_probes": 1,
  "scope_order": ["local", "module", "repository"],
  "assurance_order": ["standard", "elevated", "critical"],
  "compute_order": ["economy", "standard", "capable"],
  "mode_order": ["direct-edit", "agent", "agent-with-review"],
  "expansion_axes": ["scope", "assurance", "verification", "review", "compute"],
  "assurance_floors": {
    "critical": [
      "security", "authentication", "authorization", "permissions", "data-loss",
      "confidential", "pii", "irreversible", "production-operation"
    ],
    "elevated": [
      "database-schema", "migration", "public-api", "event-contract", "iac",
      "network", "dependency", "lockfile", "durable-requirements", "governance",
      "checklist", "generator", "external-side-effect"
    ]
  },
  "artifact_assurance_floors": {
    "critical": ["credential", "sensitive-data", "production-control"],
    "elevated": [
      "database", "public-api", "event-contract", "iac", "dependency",
      "requirements", "governance", "checklist", "generator"
    ]
  },
  "scope_profiles": {
    "local": {
      "context_budget": {"unique_files": 4, "read_bytes": 60000, "read_ranges": 12},
      "tool_budget": {"search_calls": 2, "tool_calls": 16, "subagent_calls": 0},
      "functional_verification": []
    },
    "module": {
      "context_budget": {"unique_files": 16, "read_bytes": 240000, "read_ranges": 40},
      "tool_budget": {"search_calls": 5, "tool_calls": 40, "subagent_calls": 0},
      "functional_verification": []
    },
    "repository": {
      "context_budget": {"unique_files": 48, "read_bytes": 900000, "read_ranges": 120},
      "tool_budget": {"search_calls": 10, "tool_calls": 96, "subagent_calls": 1},
      "functional_verification": []
    }
  },
  "minimum_modes": {
    "standard": "direct-edit",
    "elevated": "agent",
    "critical": "agent-with-review"
  },
  "artifact_verification": {
    "credential": ["secret-handling-check"],
    "database": ["migration-check"],
    "dependency": ["dependency-resolution-check"],
    "documentation": ["affected-document-check"],
    "event-contract": ["affected-contract"],
    "generator": ["determinism-check"],
    "governance": ["governance-consistency-check"],
    "iac": ["synthesis-check"],
    "public-api": ["affected-contract"],
    "requirements": ["requirements-consistency-check"],
    "sensitive-data": ["data-boundary-check"]
  },
  "risk_verification": {
    "authentication": ["authentication-boundary-test"],
    "authorization": ["authorization-boundary-test"],
    "data-loss": ["recovery-check"],
    "dependency": ["dependency-resolution-check"],
    "event-contract": ["affected-contract"],
    "external-side-effect": ["effect-boundary-check"],
    "iac": ["synthesis-check"],
    "irreversible": ["recovery-or-explicit-irreversibility-check"],
    "migration": ["migration-check"],
    "permissions": ["least-privilege-check"],
    "pii": ["data-boundary-check"],
    "production-operation": ["production-authority-check"],
    "public-api": ["affected-contract"],
    "security": ["security-boundary-test"]
  },
  "budget_multipliers": {
    "standard": 1.0,
    "elevated": 1.25,
    "critical": 1.5
  },
  "compute_profiles": {
    "economy": {"reasoning_effort": "low"},
    "standard": {"reasoning_effort": "medium"},
    "capable": {"reasoning_effort": "high"}
  },
  "stagnation": {
    "reject_duplicate_evidence": true,
    "reject_unchanged_axis": true,
    "warn_repeated_failure_signature": 2
  }
}
